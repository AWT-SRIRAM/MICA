<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_widget_container"
    android:padding="12dp">

    <!-- Top Row: Current Track Info & Playback Controls -->
    <LinearLayout
        android:id="@+id/widget_top_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Album Art -->
        <ImageView
            android:id="@+id/widget_album_art"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:scaleType="centerCrop"
            android:src="@mipmap/ic_ms_logo"
            android:background="@drawable/bg_widget_art"
            android:clipToOutline="true"
            android:contentDescription="Album Art" />

        <!-- Title & Artist -->
        <LinearLayout
            android:id="@+id/widget_meta_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingEnd="6dp">

            <TextView
                android:id="@+id/widget_track_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="MICA"
                android:textColor="#FFFFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/widget_track_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="The Universe of Entertainment"
                android:textColor="#B0B5C0"
                android:textSize="11.5sp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <!-- Playback Controls -->
        <LinearLayout
            android:id="@+id/widget_controls_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/widget_btn_prev"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:padding="6dp"
                android:src="@drawable/ic_widget_prev"
                android:contentDescription="Previous" />

            <!-- Circular Play/Pause Button -->
            <FrameLayout
                android:id="@+id/widget_btn_play_pause_container"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_widget_play_circle">

                <ImageView
                    android:id="@+id/widget_btn_play_pause"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_widget_play"
                    android:contentDescription="Play/Pause" />
            </FrameLayout>

            <ImageView
                android:id="@+id/widget_btn_next"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:padding="6dp"
                android:src="@drawable/ic_widget_next"
                android:contentDescription="Next" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0.6dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:background="#22FFFFFF" />

    <!-- Bottom Row: 4 Spotify-Style Quick Picks -->
    <LinearLayout
        android:id="@+id/widget_quick_picks_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:baselineAligned="false">

        <!-- Quick Pick 1 -->
        <LinearLayout
            android:id="@+id/widget_quick_card_1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="2dp">

            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_widget_quick_card"
                android:clipToOutline="true">

                <ImageView
                    android:id="@+id/widget_quick_art_1"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@mipmap/ic_ms_logo" />

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_gravity="bottom|end"
                    android:layout_margin="3dp"
                    android:src="@drawable/ic_widget_mini_play" />
            </FrameLayout>

            <TextView
                android:id="@+id/widget_quick_title_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Trending"
                android:textColor="#E0E2EC"
                android:textSize="10sp"
                android:gravity="center"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <!-- Quick Pick 2 -->
        <LinearLayout
            android:id="@+id/widget_quick_card_2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="2dp">

            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_widget_quick_card"
                android:clipToOutline="true">

                <ImageView
                    android:id="@+id/widget_quick_art_2"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@mipmap/ic_ms_logo" />

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_gravity="bottom|end"
                    android:layout_margin="3dp"
                    android:src="@drawable/ic_widget_mini_play" />
            </FrameLayout>

            <TextView
                android:id="@+id/widget_quick_title_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Top Hits"
                android:textColor="#E0E2EC"
                android:textSize="10sp"
                android:gravity="center"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <!-- Quick Pick 3 -->
        <LinearLayout
            android:id="@+id/widget_quick_card_3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="2dp">

            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_widget_quick_card"
                android:clipToOutline="true">

                <ImageView
                    android:id="@+id/widget_quick_art_3"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@mipmap/ic_ms_logo" />

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_gravity="bottom|end"
                    android:layout_margin="3dp"
                    android:src="@drawable/ic_widget_mini_play" />
            </FrameLayout>

            <TextView
                android:id="@+id/widget_quick_title_3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Lofi Beats"
                android:textColor="#E0E2EC"
                android:textSize="10sp"
                android:gravity="center"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <!-- Quick Pick 4 -->
        <LinearLayout
            android:id="@+id/widget_quick_card_4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="2dp">

            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_widget_quick_card"
                android:clipToOutline="true">

                <ImageView
                    android:id="@+id/widget_quick_art_4"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@mipmap/ic_ms_logo" />

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_gravity="bottom|end"
                    android:layout_margin="3dp"
                    android:src="@drawable/ic_widget_mini_play" />
            </FrameLayout>

            <TextView
                android:id="@+id/widget_quick_title_4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Discover"
                android:textColor="#E0E2EC"
                android:textSize="10sp"
                android:gravity="center"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
