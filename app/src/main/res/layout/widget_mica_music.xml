<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_widget_container"
    android:gravity="center_vertical"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <!-- Top Section: Album Artwork + Metadata -->
    <LinearLayout
        android:id="@+id/widget_top_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Album Art with Mini MICA Badge -->
        <FrameLayout
            android:layout_width="56dp"
            android:layout_height="56dp">

            <ImageView
                android:id="@+id/widget_album_art"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@mipmap/ic_ms_logo"
                android:background="@drawable/bg_widget_art"
                android:contentDescription="Album Art" />

            <ImageView
                android:id="@+id/widget_logo_badge"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="bottom|end"
                android:src="@mipmap/ic_ms_logo"
                android:contentDescription="MICA" />
        </FrameLayout>

        <!-- Track Title & Artist -->
        <LinearLayout
            android:id="@+id/widget_meta_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="8dp">

            <TextView
                android:id="@+id/widget_track_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="MICA"
                android:textColor="#FFFFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/widget_track_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="The Universe of Entertainment"
                android:textColor="#B0B5C0"
                android:textSize="12sp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>

    <!-- Audio Seekbar Timeline Row -->
    <LinearLayout
        android:id="@+id/widget_timeline_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_time_elapsed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00"
            android:textColor="#8892A4"
            android:textSize="11sp" />

        <ProgressBar
            android:id="@+id/widget_progress_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="4dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:max="100"
            android:progress="0"
            android:progressTint="#38BDF8" />

        <TextView
            android:id="@+id/widget_time_total"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00"
            android:textColor="#8892A4"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Bottom Controls: 5 Symmetric Buttons -->
    <LinearLayout
        android:id="@+id/widget_controls_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- 1. Favorite / Add to Playlist (+) -->
        <FrameLayout
            android:id="@+id/widget_btn_like_container"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1">

            <ImageView
                android:id="@+id/widget_btn_like"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_notif_like_add"
                android:contentDescription="Favorite" />
        </FrameLayout>

        <!-- 2. Skip Previous (|◀) -->
        <FrameLayout
            android:id="@+id/widget_btn_prev_container"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1">

            <ImageView
                android:id="@+id/widget_btn_prev"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_notif_prev"
                android:contentDescription="Previous" />
        </FrameLayout>

        <!-- 3. Circular Play/Pause (|| / ▶) -->
        <FrameLayout
            android:id="@+id/widget_btn_play_pause_container"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1.2">

            <FrameLayout
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_widget_play_circle">

                <ImageView
                    android:id="@+id/widget_btn_play_pause"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_widget_play"
                    android:contentDescription="Play/Pause" />
            </FrameLayout>
        </FrameLayout>

        <!-- 4. Skip Next (▶|) -->
        <FrameLayout
            android:id="@+id/widget_btn_next_container"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1">

            <ImageView
                android:id="@+id/widget_btn_next"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_notif_next"
                android:contentDescription="Next" />
        </FrameLayout>

        <!-- 5. Shuffle / Loop Toggle (⤲ / 🔁) -->
        <FrameLayout
            android:id="@+id/widget_btn_shuffle_repeat_container"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1">

            <ImageView
                android:id="@+id/widget_btn_shuffle_repeat"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_notif_repeat"
                android:contentDescription="Repeat/Shuffle" />
        </FrameLayout>
    </LinearLayout>

</LinearLayout>
